#usda 1.0
(
    defaultPrim = "husky"
)

def Xform "husky" (
    references = @assets/USD_Assets/robots/ros2_husky_PhysX_vlp16_mono_depth_imu.usd@
)
{
    # --- D455 ---------------------------------------------------------
    # d455 は base USD 内で "../common/rsd455.usd" を参照しているが、
    # それが見つからないため、ここで正しい場所に差し替える。
    over "d455" (
        references = @assets/USD_Assets/common/rsd455.usd@   # ← 実在パスに修正
    )
    {
        over "RSD455" {
            over "Imu_Sensor" {
                double dt = 0.01   # 200 Hz
            }
        }
    }

    # --- VLP16 --------------------------------------------------------
    # base USD は "vlp16.usd" を payload しているが見つからないので差し替え。
    over "base_link" {
        over "vlp16" (
            payload = @assets/USD_Assets/sensors/vlp16.usd@   # ← 実在パスに修正
        )
        {
            over "Lidar" {
                double dt = 0.1     # 10 Hz
            }
        }
    }
}
